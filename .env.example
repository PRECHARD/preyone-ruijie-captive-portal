# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://wifi.preyone.com

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=captive_portal
DB_USER=postgres
DB_PASSWORD=your_password_here

# Session Logic (Minutes)
DEFAULT_SESSION_MIN=60
SESSION_CLEANUP_INTERVAL_MIN=15
ENABLE_SESSION_CLEANUP=true

# Logging & Auditing
ACCESS_LOG_CLEANUP_INTERVAL_MIN=60
ACCESS_LOG_RETENTION_DAYS=30
ENABLE_ACCESS_LOG_CLEANUP=true

# Ruijie AP gateway success-callback URL (leave blank to use original URL fallback)
RUIJIE_SUCCESS_URL=

# Ruijie AP admin password (default: PreyoneNetAccess)
RUIJIE_PASSWORD=

# Ruijie Cloud voucher minting (appid + secret from the Ruijie Cloud client,
# token from the closed-doc client config; groupId = "Preyone UltraNet Wi-Fi").
# When APPID+SECRET+GROUP_ID are all set, paid and staff vouchers are minted
# directly from Ruijie Cloud instead of generated locally.
RUIJIE_CLOUD_APPID=
RUIJIE_CLOUD_SECRET=
RUIJIE_CLOUD_GROUP_ID=9624342
RUIJIE_CLOUD_TOKEN=

# Pre-minted Ruijie stock per active tier. The worker refills whenever the
# available count drops to VOUCHER_POOL_LOW_WATERMARK or below.
VOUCHER_POOL_TARGET=10
VOUCHER_POOL_LOW_WATERMARK=5
VOUCHER_POOL_INTERVAL_MIN=15
ENABLE_VOUCHER_POOL=true


# JWT secret (REQUIRED — app will crash on start if not set in production; use a strong random value)
JWT_SECRET=change-this-to-a-random-secret

# Signing secret for offline POS device leases (7-day hardware-bound tokens).
# Falls back to JWT_SECRET when blank; set a separate value so rotating leases
# does not invalidate every staff session.
POS_LEASE_SECRET=

# Optional external SPA bundles for subdomains whose build lives outside this
# repo. Defaults are ./invoice/dist and ./homeautomate/dist; point these at an
# absolute path when the invoicing or home-automation app is deployed separately.
INVOICE_DIST=
HOMEAUTOMATE_DIST=

# Who receives the transaction advice email for every successful online WiFi
# payment. Comma/semicolon separated. Defaults to approved CEO/Manager accounts,
# then admin@preyone.com.
ONLINE_PAYMENT_RECIPIENTS=

# Pesepay payment gateway (Zimbabwe — EcoCash)
# Integration key; sent as the `authorization` header on every request.
# PESEPAY_API_KEY is accepted as an alias.
PESEPAY_INTEGRATION_KEY=
# Shared encryption key (AES-CBC). MUST be exactly 16, 24 or 32 bytes and must
# match the key configured in the Pesepay dashboard. The first 16 characters are
# used as the IV. A wrong-length key silently produces unreadable payloads.
PESEPAY_ENCRYPTION_KEY=
# Pesepay POSTs the encrypted payment result to BASE_URL/api/payments/webhook.
# A per-payment ?token= is appended to resultUrl automatically and is verified
# whenever Pesepay echoes it back; the AES payload itself is the primary
# authentication.
# Leave both keys blank to disable online payments: /api/payments/initiate then
# returns HTTP 422 and customers are directed to buy their voucher elsewhere.
PESEPAY_RESULT_URL=https://api.preyone.com/api/payments/pesepay/callback
PESEPAY_RETURN_URL=https://app.preyone.com/payment-status
PESEPAY_BASE_URL=https://api.pesepay.com/api/payments-engine/v2/payments/make-payment
# Subscription renewals: point the Pesepay dashboard WEBHOOK at
#   https://api.preyone.com/api/payments/pesepay/webhook
# It authenticates with PESEPAY_INTEGRATION_KEY (same authorization header as
# the callback). A successful renewal extends subscription_expires_at by +30
# days, sets subscription_status back to 'active' and clears the dunning flags.

# 3-tier SaaS subscription engine (Standard $10 / Growth $20 / Unlimited $30)
# Daily dunning at midnight: 3-day warning email, 1-day urgent notice, then
# suspension for companies whose subscription_expires_at has elapsed.
ENABLE_SUBSCRIPTION_CRON=true

# -- Hybrid voucher alerts (Web Push) --
# Generate with: npx web-push generate-vapid-keys
# Leave empty to run portal-banner-only (no OS push).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://wifi.preyone.com
# Set to 1 to stop the in-process 80%/95% threshold sweep.
VOUCHER_MONITOR_DISABLED=0
