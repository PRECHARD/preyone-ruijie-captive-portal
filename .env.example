# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://wifi.preyone.com

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=captive_portal
DB_USER=postgres
DB_PASSWORD=your_password_here

# Session Logic (Minutes)
DEFAULT_SESSION_MIN=60
SESSION_CLEANUP_INTERVAL_MIN=15
ENABLE_SESSION_CLEANUP=true

# Logging & Auditing
ACCESS_LOG_CLEANUP_INTERVAL_MIN=60
ACCESS_LOG_RETENTION_DAYS=30
ENABLE_ACCESS_LOG_CLEANUP=true

# Ruijie AP gateway success-callback URL (leave blank to use original URL fallback)
RUIJIE_SUCCESS_URL=

# Ruijie AP admin password (default: PreyoneNetAccess)
RUIJIE_PASSWORD=

# JWT secret (REQUIRED — app will crash on start if not set in production; use a strong random value)
JWT_SECRET=change-this-to-a-random-secret

# Pesepay gateway (encrypted JSON API — EcoCash, InnBucks, Zimswitch, Visa, Mastercard)
# PESEPAY_INTEGRATION_KEY is also the shared secret Pesepay sends in the callback `authorization` header.
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_RESULT_URL=https://api.preyone.com/api/payments/pesepay/callback
PESEPAY_RETURN_URL=https://app.preyone.com/payment-status
PESEPAY_BASE_URL=https://api.pesepay.com/api/payments-engine/v2/payments/make-payment
