# Server Configuration
PORT=3000
NODE_ENV=production
BASE_URL=https://wifi.preyone.com

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=captive_portal
DB_USER=postgres
DB_PASSWORD=your_password_here

# Session Logic (Minutes)
DEFAULT_SESSION_MIN=60
SESSION_CLEANUP_INTERVAL_MIN=15
ENABLE_SESSION_CLEANUP=true

# Logging & Auditing
ACCESS_LOG_CLEANUP_INTERVAL_MIN=60
ACCESS_LOG_RETENTION_DAYS=30
ENABLE_ACCESS_LOG_CLEANUP=true

# Ruijie AP gateway success-callback URL (leave blank to use original URL fallback)
RUIJIE_SUCCESS_URL=

# Ruijie AP admin password (default: PreyoneNetAccess)
RUIJIE_PASSWORD=

# Ruijie Cloud voucher minting (appid + secret from the Ruijie Cloud client,
# token from the closed-doc client config; groupId = "Preyone UltraNet Wi-Fi").
# When APPID+SECRET+GROUP_ID are all set, paid and staff vouchers are minted
# directly from Ruijie Cloud instead of generated locally.
RUIJIE_CLOUD_APPID=
RUIJIE_CLOUD_SECRET=
RUIJIE_CLOUD_GROUP_ID=9624342
RUIJIE_CLOUD_TOKEN=

# JWT secret (REQUIRED — app will crash on start if not set in production; use a strong random value)
JWT_SECRET=change-this-to-a-random-secret

# Pesepay payment gateway (Zimbabwe — EcoCash)
# Integration key; sent as the `authorization` header on every request.
# PESEPAY_API_KEY is accepted as an alias.
PESEPAY_INTEGRATION_KEY=
# Shared encryption key (AES-CBC). MUST be exactly 16, 24 or 32 bytes and must
# match the key configured in the Pesepay dashboard. The first 16 characters are
# used as the IV. A wrong-length key silently produces unreadable payloads.
PESEPAY_ENCRYPTION_KEY=
# Pesepay POSTs the encrypted payment result to BASE_URL/api/payments/webhook.
# A per-payment ?token= is appended to resultUrl automatically and is verified
# whenever Pesepay echoes it back; the AES payload itself is the primary
# authentication.
# Leave both keys blank to disable online payments: /api/payments/initiate then
# returns HTTP 422 and customers are directed to buy their voucher elsewhere.
